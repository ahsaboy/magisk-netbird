# Force LF line endings for shell scripts (Android requires LF, not CRLF)
*.sh text eol=lf
*.prop text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
module/META-INF/** text eol=lf
# Extensionless scripts (netbird.service, module-status.sh, cert-trust.sh, start.sh, update-binary)
module/netbird/scripts/* text eol=lf
module/webroot/* text eol=lf
# WebUI bridge sources (moved out of module/webroot, still executed on Android)
ui/src/kernelsu.js text eol=lf
ui/src/view-model.mjs text eol=lf
