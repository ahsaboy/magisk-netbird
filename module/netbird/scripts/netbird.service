#!/system/bin/sh

DIR=$(dirname "$(realpath "$0")")
. "$DIR/../settings.sh"

pid_file="$NB_RUN_DIR/netbird.pid"
cert_trust_script="$NB_SCRIPTS_DIR/cert-trust.sh"
module_status_script="$NB_SCRIPTS_DIR/module-status.sh"
overlay_rule_pref="90"
root_route_rule_pref="100"

is_running() {
  busybox pgrep -f "$NB_DAEMON_CMD" >/dev/null 2>&1
}

family_ip() {
  case "$1" in
    4)
      shift
      ip "$@"
      ;;
    6)
      shift
      ip -6 "$@"
      ;;
    *)
      return 1
      ;;
  esac
}

ensure_overlay_route_family() {
  route_family="$1"
  fallback_cidr="$2"

  if family_ip "$route_family" rule show 2>/dev/null |
    grep -q "lookup main suppress_prefixlength 0"; then
    return 0
  fi
  if family_ip "$route_family" rule add pref "$overlay_rule_pref" from all \
    lookup main suppress_prefixlength 0 >/dev/null 2>&1; then
    return 0
  fi
  # A failed add may have raced with another refresh; accept a rule that is
  # visible now before trying the narrower overlay-prefix fallback.
  if family_ip "$route_family" rule show 2>/dev/null |
    grep -q "to $fallback_cidr lookup main"; then
    return 0
  fi
  if family_ip "$route_family" rule add pref "$overlay_rule_pref" \
    to "$fallback_cidr" lookup main >/dev/null 2>&1; then
    return 0
  fi

  log Warning "Failed to install IPv$route_family overlay route precedence rule."
  return 1
}

ensure_overlay_route_precedence() {
  # Keep IPv4 and IPv6 checks independent. A working IPv4 suppress rule must
  # not prevent the IPv6 overlay rule from being installed.
  overlay_rc=0
  ensure_overlay_route_family 4 100.64.0.0/10 || overlay_rc=1
  ensure_overlay_route_family 6 fd00::/8 || overlay_rc=1
  return "$overlay_rc"
}

resolve_android_table_id() {
  table_name="$1"
  case "$table_name" in
    '') return 1 ;;
    main) echo 254; return 0 ;;
    default) echo 253; return 0 ;;
    local) echo 255; return 0 ;;
    *[!0-9]*)
      table_id="$(
        awk -v name="$table_name" '$2 == name && $1 ~ /^[0-9]+$/ { print $1; exit }' \
          /data/misc/net/rt_tables /etc/iproute2/rt_tables 2>/dev/null || true
      )"
      if [ -z "$table_id" ]; then
        # Android netd assigns physical-interface tables as ifindex + 1000.
        # This also works when ip prints a name it cannot parse on input.
        case "$table_name" in *[!A-Za-z0-9_.-]*) return 1 ;; esac
        [ -r "/sys/class/net/$table_name/ifindex" ] || return 1
        IFS= read -r table_ifindex < "/sys/class/net/$table_name/ifindex" || true
        case "$table_ifindex" in ''|*[!0-9]*) return 1 ;; esac
        table_id=$((table_ifindex + 1000))
      fi
      ;;
    *) table_id="$table_name" ;;
  esac
  case "$table_id" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s\n' "$table_id"
}

get_android_default_table() {
  route_family="$1"

  # Read Android netd's current default-network rule, not the first default
  # route: multiple rmnet interfaces and VPN/TUN tables can coexist.
  route_name="$(
    family_ip "$route_family" rule show 2>/dev/null |
      awk '/fwmark 0x0\/0xffff/ && /iif lo/ && /lookup/ {
        for (i = 1; i <= NF; i++) {
          if ($i == "lookup") {
            print $(i + 1)
            exit
          }
        }
      }'
  )"
  route_id="$(resolve_android_table_id "$route_name" 2>/dev/null || true)"
  if [ -n "$route_id" ] &&
    family_ip "$route_family" route show table "$route_id" 2>/dev/null |
      grep -q '^default '; then
    echo "$route_id"
    return 0
  fi

  # Older Android variants may use different rule formatting. Fall back to
  # physical-interface defaults, but only if they identify one unique table.
  # Choosing an arbitrary rmnet table can silently break IPv6 connectivity.
  fallback_table=""
  for route_name in $(
    family_ip "$route_family" route show table all 2>/dev/null |
      awk '/^default / &&
           $0 !~ / dev dummy0( |$)/ &&
           $0 !~ / dev (tun|wt|wg|nb|netbird)[^ ]*( |$)/ {
        table = "main"
        for (i = 1; i <= NF; i++)
          if ($i == "table") { table = $(i + 1); break }
        print table
      }' | sort -u
  ); do
    route_id="$(resolve_android_table_id "$route_name" 2>/dev/null || true)"
    [ -n "$route_id" ] || continue
    if ! family_ip "$route_family" route show table "$route_id" 2>/dev/null |
      grep -q '^default '; then
      continue
    fi
    if [ -n "$fallback_table" ] && [ "$fallback_table" != "$route_id" ]; then
      return 1
    fi
    fallback_table="$route_id"
  done
  [ -n "$fallback_table" ] || return 1
  echo "$fallback_table"
}

# Delete only our pref-100 UID 0 rule. Omit lookup on deletion: some Android
# ip builds print symbolic table names but reject them as input (invalid ID).
cleanup_root_route_family() {
  cleanup_family="$1"
  while :; do
    cleanup_rules="$(family_ip "$cleanup_family" rule show 2>/dev/null)" || {
      log Warning "Failed to inspect IPv$cleanup_family routing rules."
      return 1
    }
    if ! printf '%s\n' "$cleanup_rules" |
      awk -v p="$root_route_rule_pref:" '$1 == p && /uidrange 0-0/ { found = 1 } END { exit !found }'; then
      return 0
    fi
    family_ip "$cleanup_family" rule del pref "$root_route_rule_pref" \
      from all uidrange 0-0 >/dev/null 2>&1 || {
      log Warning "Failed to remove IPv$cleanup_family root uid route rule."
      return 1
    }
  done
}

ensure_android_route_family() {
  route_family="$1"
  route_table="$(get_android_default_table "$route_family" 2>/dev/null || true)"

  # No unambiguous underlay for this family: do not leave a stale rule.
  if [ -z "$route_table" ]; then
    cleanup_root_route_family "$route_family"
    return "$?"
  fi

  route_rule_current=0
  for current_lookup in $(
    family_ip "$route_family" rule show 2>/dev/null |
      awk -v p="$root_route_rule_pref:" \
        '$1 == p && /uidrange 0-0/ {
          for (i = 1; i <= NF; i++)
            if ($i == "lookup") print $(i + 1)
        }'
  ); do
    current_id="$(resolve_android_table_id "$current_lookup" 2>/dev/null || true)"
    if [ "$current_id" = "$route_table" ]; then
      route_rule_current=1
    else
      # Priority plus UID range identifies this module's rule; lookup names
      # are unreliable in DEL requests on some Android ip builds.
      family_ip "$route_family" rule del pref "$root_route_rule_pref" \
        from all uidrange 0-0 >/dev/null 2>&1 || {
        log Warning "Failed to remove stale IPv$route_family root uid route rule."
        return 1
      }
    fi
  done

  [ "$route_rule_current" -eq 1 ] && return 0

  if ! family_ip "$route_family" rule add pref "$root_route_rule_pref" \
    from all uidrange 0-0 lookup "$route_table" >/dev/null 2>&1; then
    log Warning "Failed to add IPv$route_family root uid route rule for table $route_table."
    return 1
  fi
  return 0
}

ensure_android_route() {
  route_rc=0
  ensure_overlay_route_precedence || route_rc=1
  ensure_android_route_family 4 || route_rc=1
  ensure_android_route_family 6 || route_rc=1
  return "$route_rc"
}

cleanup_overlay_route_family() {
  cleanup_family="$1"
  cleanup_cidr="$2"
  cleanup_rc=0
  cleanup_rules="$(family_ip "$cleanup_family" rule show 2>/dev/null)" || {
    log Warning "Failed to inspect IPv$cleanup_family overlay routing rules."
    return 1
  }

  if printf '%s\n' "$cleanup_rules" |
    grep -q "lookup main suppress_prefixlength 0"; then
    if ! family_ip "$cleanup_family" rule del pref "$overlay_rule_pref" \
      from all lookup main suppress_prefixlength 0 >/dev/null 2>&1; then
      log Warning "Failed to remove IPv$cleanup_family overlay route precedence rule."
      cleanup_rc=1
    fi
  fi
  cleanup_rules="$(family_ip "$cleanup_family" rule show 2>/dev/null)" || {
    log Warning "Failed to recheck IPv$cleanup_family overlay routing rules."
    return 1
  }
  if printf '%s\n' "$cleanup_rules" |
    grep -q "to $cleanup_cidr lookup main"; then
    if ! family_ip "$cleanup_family" rule del pref "$overlay_rule_pref" \
      to "$cleanup_cidr" lookup main >/dev/null 2>&1; then
      log Warning "Failed to remove IPv$cleanup_family overlay fallback rule."
      cleanup_rc=1
    fi
  fi
  return "$cleanup_rc"
}

# Drop route and firewall rules this module added (used on stop/uninstall).
cleanup_runtime() {
  cleanup_rc=0
  cleanup_overlay_route_family 4 100.64.0.0/10 || cleanup_rc=1
  cleanup_overlay_route_family 6 fd00::/8 || cleanup_rc=1
  cleanup_root_route_family 4 || cleanup_rc=1
  cleanup_root_route_family 6 || cleanup_rc=1
  # The wt0 interface is already destroyed when the daemon exits, so delete
  # the rules by parsing the live rule list instead of enumerating interfaces.
  for fw in iptables ip6tables; do
    command -v "$fw" >/dev/null 2>&1 || continue
    for chain in INPUT OUTPUT; do
      fw_rules="$("$fw" -S "$chain" 2>/dev/null)" || {
        log Warning "Failed to inspect $fw $chain rules."
        cleanup_rc=1
        continue
      }
      del_rules="$(
        printf '%s\n' "$fw_rules" |
          grep -E "^-A $chain -[io] (wt|wg|nb|netbird)[0-9a-zA-Z._@-]* -p (icmp|ipv6-icmp) -j ACCEPT" |
          sed 's/^-A /-D /' || true
      )"
      while IFS= read -r del_rule; do
        [ -n "$del_rule" ] || continue
        # shellcheck disable=SC2086
        if ! "$fw" $del_rule >/dev/null 2>&1; then
          log Warning "Failed to remove $fw rule: $del_rule"
          cleanup_rc=1
        fi
      done <<EOF
$del_rules
EOF
    done
  done
  return "$cleanup_rc"
}

ensure_rule() {
  if "$@" -C "$rule_chain" $rule_args >/dev/null 2>&1; then
    return 0
  fi
  if ! "$@" -I "$rule_chain" 1 $rule_args >/dev/null 2>&1; then
    log Warning "Failed to add firewall rule to $rule_chain: $rule_args"
    return 1
  fi
  return 0
}

netbird_ifaces() {
  ip -o link show 2>/dev/null |
    awk -F': ' '$2 ~ /^(wt|wg|nb|netbird)/ { print $2 }' |
    cut -d@ -f1
}

ensure_netbird_icmp_firewall() {
  firewall_rc=0
  for iface in $(netbird_ifaces); do
    rule_chain="INPUT"
    rule_args="-i $iface -p icmp -j ACCEPT"
    ensure_rule iptables || firewall_rc=1
    rule_chain="OUTPUT"
    rule_args="-o $iface -p icmp -j ACCEPT"
    ensure_rule iptables || firewall_rc=1

    if command -v ip6tables >/dev/null 2>&1; then
      rule_chain="INPUT"
      rule_args="-i $iface -p ipv6-icmp -j ACCEPT"
      ensure_rule ip6tables || firewall_rc=1
      rule_chain="OUTPUT"
      rule_args="-o $iface -p ipv6-icmp -j ACCEPT"
      ensure_rule ip6tables || firewall_rc=1
    fi
  done
  return "$firewall_rc"
}

refresh_runtime() {
  refresh_rc=0
  if [ -x "$cert_trust_script" ] &&
    ! "$cert_trust_script" update >/dev/null 2>&1; then
    log Warning "Failed to refresh the CA trust bundle."
    refresh_rc=1
  fi
  ensure_android_route || refresh_rc=1
  ensure_netbird_icmp_firewall || refresh_rc=1
  return "$refresh_rc"
}

update_module_status() {
  [ -x "$module_status_script" ] || return 0
  "$module_status_script" update >/dev/null 2>&1 || true
}

start_module_status() {
  [ -x "$module_status_script" ] || return 0
  "$module_status_script" start >/dev/null 2>&1 || true
}

stop_module_status() {
  [ -x "$module_status_script" ] || return 0
  "$module_status_script" stop >/dev/null 2>&1
}

start_service() {
  # Desired-state marker for the watchdog: set whenever the daemon should be
  # running, cleared by stop_service. The watchdog only restarts when set.
  echo 1 > "$NB_RUN_DIR/netbird.desired"
  log Info "Starting NetBird daemon."
  if is_running; then
    log Info "NetBird daemon is already running."
    refresh_runtime
    start_rc="$?"
    start_module_status || start_rc=1
    return "$start_rc"
  fi
  if ! command -v netbird >/dev/null 2>&1; then
    log Error "netbird binary not found."
    rm -f "$NB_RUN_DIR/netbird.desired"
    update_module_status
    return 1
  fi
  if ! ensure_android_route; then
    log Error "Failed to prepare Android routing for NetBird."
    rm -f "$NB_RUN_DIR/netbird.desired"
    update_module_status
    return 1
  fi
  rm -f "$NB_SOCKET"
  [ -f "$NB_LOG_FILE_PATH" ] && mv "$NB_LOG_FILE_PATH" "$NB_LOG_FILE_PATH.bak"
  # shellcheck disable=SC2086
  nohup $NB_DAEMON_CMD > "$NB_LOG_FILE_PATH" 2>&1 &
  pid="$!"
  sleep 3
  if ps -p "$pid" >/dev/null 2>&1; then
    echo "$pid" > "$pid_file"
    log Info "NetBird daemon started with PID $pid."
    start_module_status
    # Re-apply runtime bits after the interface is up, but bail out if the
    # service was stopped in the meantime (must not re-add cleaned-up rules).
    (
      sleep 5
      is_running || exit 0
      refresh_runtime
      update_module_status
    ) >/dev/null 2>&1 &
    return 0
  fi
  log Error "NetBird daemon failed to start."
  update_module_status
  return 1
}

stop_service() {
  # Clear desired state first so the watchdog never races a manual stop.
  rm -f "$NB_RUN_DIR/netbird.desired"
  log Info "Stopping NetBird daemon."
  stop_rc=0
  if ! is_running; then
    cleanup_runtime || stop_rc=1
    log Info "NetBird daemon is not running."
    stop_module_status || stop_rc=1
    return "$stop_rc"
  fi
  for pid in $(busybox pgrep -f "$NB_DAEMON_CMD" 2>/dev/null); do
    kill -15 "$pid" >/dev/null 2>&1 || true
  done
  sleep 3
  if is_running; then
    log Warning "NetBird daemon did not stop cleanly; forcing stop."
    for pid in $(busybox pgrep -f "$NB_DAEMON_CMD" 2>/dev/null); do
      kill -9 "$pid" >/dev/null 2>&1 || true
    done
  fi
  if is_running; then
    log Error "NetBird daemon is still running after stop."
    stop_rc=1
  fi
  cleanup_runtime || stop_rc=1
  rm -f "$pid_file"
  stop_module_status || stop_rc=1
  return "$stop_rc"
}

daemon_status() {
  if is_running; then
    echo "daemon: running"
    return 0
  fi
  echo "daemon: stopped"
  return 1
}

client_cmd() {
  refresh_runtime
  (
    unset NB_CONFIG
    netbird --daemon-addr "$NB_DAEMON_ADDR" "$@"
  )
}

webui_client() {
  (
    unset NB_CONFIG
    netbird --daemon-addr "$NB_DAEMON_ADDR" "$@"
  )
}

webui_network_id() {
  webui_network="$1"
  [ -n "$webui_network" ] || return 1
  [ "$webui_network" != "--" ] || return 1
  case "$webui_network" in *[[:space:]]*) return 1 ;; esac
  return 0
}

webui_network_ids() {
  [ "$#" -gt 0 ] || return 1
  webui_network_needs_lookup=0
  for webui_network in "$@"; do
    if [ "$webui_network" = "all" ]; then
      continue
    fi
    webui_network_id "$webui_network" || return 1
    webui_network_needs_lookup=1
  done
  [ "$webui_network_needs_lookup" -eq 1 ] || return 0

  webui_network_list="$(webui_client networks list 2>/dev/null)" || return 1
  for webui_network in "$@"; do
    [ "$webui_network" = "all" ] && continue
    if ! printf '%s\n' "$webui_network_list" |
      awk -v wanted="$webui_network" \
        '$1 == "-" && $2 == "ID:" && $3 == wanted { found = 1 }
         END { exit !found }'; then
      return 1
    fi
  done
}

webui_value() {
  case "${1:-}" in
    ''|*[!A-Za-z0-9:._/-]*) return 1 ;;
  esac
}

webui_status() {
  if ! is_running; then
    printf '%s\n' '{"daemon":"stopped"}'
    return 1
  fi
  webui_client status --json
}

webui_health() {
  health_check="${1:-live}"
  case "$health_check" in
    live|ready|startup) ;;
    *) echo "usage: webui health {live|ready|startup}" >&2; return 2 ;;
  esac
  webui_client status --check "$health_check" >/dev/null 2>&1
  health_rc="$?"
  if [ "$health_rc" -eq 0 ]; then
    printf '{"check":"%s","ok":true,"exit":0}\n' "$health_check"
  else
    printf '{"check":"%s","ok":false,"exit":%s}\n' "$health_check" "$health_rc"
  fi
  return "$health_rc"
}

webui_network_change() {
  network_action="$1"
  shift
  case "$network_action" in
    select|select-append|deselect) ;;
    *) return 2 ;;
  esac
  webui_network_ids "$@" || {
    echo "invalid network identifier" >&2
    return 2
  }
  if [ "$network_action" = "select-append" ]; then
    webui_client networks select -a "$@"
  else
    webui_client networks "$network_action" "$@"
  fi
  network_rc="$?"
  update_module_status
  return "$network_rc"
}

webui_profile_select() {
  profile_name="${1:-}"
  webui_value "$profile_name" || { echo "invalid profile name" >&2; return 2; }
  webui_client profile select "$profile_name"
}

up_cmd() {
  # Opt-in flags (see settings.sh): NB_DISABLE_IPV6=true / NB_DISABLE_FIREWALL=true.
  # Appended before "$@" so an explicit flag on the command line still wins.
  up_extra_flags=""
  if [ "$NB_DISABLE_IPV6" = "true" ]; then
    up_extra_flags="$up_extra_flags --disable-ipv6"
  fi
  if [ "$NB_DISABLE_FIREWALL" = "true" ]; then
    up_extra_flags="$up_extra_flags --disable-firewall"
  fi
  # shellcheck disable=SC2086
  client_cmd up --disable-dns $up_extra_flags "$@"
  rc="$?"
  refresh_runtime
  return "$rc"
}

usage() {
  echo "usage: netbird.service {start|stop|restart|status|up|down|login|log|refresh|route|peers|version|webui}"
  echo "  log follows the client log; use log --once for the latest 200 lines."
  echo "  webui actions: status health version networks networks-select networks-append networks-deselect forwarding state profile-list profile-select"
  echo "  up always adds --disable-dns before your extra flags."
  echo "  peers shows per-peer connection type (P2P/Relayed), latency and traffic."
  echo "  Set NB_DISABLE_IPV6=true and/or NB_DISABLE_FIREWALL=true to append those on up."
}

case "${1:-}" in
  start)
    start_service
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    rc="$?"
    [ "$rc" -eq 0 ] || exit "$rc"
    sleep 1
    start_service
    ;;
  status)
    shift
    if daemon_status; then
      client_cmd status "$@"
      rc="$?"
      update_module_status
      exit "$rc"
    else
      update_module_status
      exit 1
    fi
    ;;
  up)
    shift
    start_service
    up_cmd "$@"
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  down)
    shift
    client_cmd down "$@"
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  login)
    shift
    start_service
    client_cmd login "$@"
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  log)
    shift
    case "${1:-}" in
      --once)
        if [ -f "$NB_LOG_FILE_PATH" ]; then
          busybox tail -n 200 "$NB_LOG_FILE_PATH"
        else
          echo "NetBird log is not available."
        fi
        ;;
      '')
        busybox tail -n 200 -f "$NB_LOG_FILE_PATH"
        ;;
      *)
        echo "usage: netbird.service log [--once]"
        exit 2
        ;;
    esac
    ;;
  refresh)
    refresh_runtime
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  route)
    ensure_android_route
    exit "$?"
    ;;
  peers)
    exec "$module_status_script" peers
    ;;
  webui)
    shift
    case "${1:-}" in
      status)
        webui_status
        exit "$?"
        ;;
      health)
        shift
        webui_health "$@"
        exit "$?"
        ;;
      version)
        webui_client version
        exit "$?"
        ;;
      networks)
        webui_client networks list
        exit "$?"
        ;;
      networks-select)
        shift
        webui_network_change select "$@"
        exit "$?"
        ;;
      networks-append)
        shift
        webui_network_change select-append "$@"
        exit "$?"
        ;;
      networks-deselect)
        shift
        webui_network_change deselect "$@"
        exit "$?"
        ;;
      forwarding)
        webui_client forwarding list
        exit "$?"
        ;;
      state)
        webui_client state list
        exit "$?"
        ;;
      profile-list)
        webui_client profile list
        exit "$?"
        ;;
      profile-select)
        shift
        webui_profile_select "$@"
        exit "$?"
        ;;
      *)
        echo "usage: netbird.service webui {status|health|version|networks|networks-select|networks-append|networks-deselect|forwarding|state|profile-list|profile-select}" >&2
        exit 2
        ;;
    esac
    ;;
  version)
    client_cmd version
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  *)
    usage
    ;;
esac
