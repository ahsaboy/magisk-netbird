# NetBird Magisk module - user configuration template
#
# Create your config with:
#   cp /data/adb/netbird/netbird.env.example /data/adb/netbird/.env
# then uncomment/edit lines. Format: KEY=VALUE, one per line, '#' is a comment.
#
# Precedence: real environment variables > this file > built-in defaults.
# The file is read by every module script on each run. Variables consumed by
# the daemon itself (NB_LOG_LEVEL, NB_DISABLE_IPV6, ...) apply after the next
# `netbird.service restart`.

# --- Logging ---
# Client log level: debug | info | warn | error | fatal
#NB_LOG_LEVEL=info
# NetBird built-in log rotation cap for client.log, in MiB
# (upstream default is 15; this module defaults to 5)
#NB_LOG_MAX_SIZE_MB=5

# --- Flags appended by `netbird.service up` ---
# (environment variables outrank CLI flags in NetBird)
# Also append --disable-ipv6 on up (disables NetBird overlay IPv6; this is
# not a workaround for missing Android ip6tables nat support)
#NB_DISABLE_IPV6=false
# Also append --disable-firewall on up (client stops managing firewall rules)
#NB_DISABLE_FIREWALL=false

# --- Android userspace fallback ---
# Force NetBird's userspace firewall. If unset, the module enables it
# automatically when Android has no usable ip6tables IPv6 nat table.
#NB_FORCE_USERSPACE_FIREWALL=true
# Force userspace WireGuard. If unset, the module enables it together with the
# automatic userspace-firewall fallback.
#NB_WG_KERNEL_DISABLED=true

# --- Official client variables (docs.netbird.io/client/environment-variables) ---
# Skip direct P2P connectivity entirely; force relay for all peers (debugging)
#NB_FORCE_RELAY=false
# Reconnection backoff after losing management/signal
#NB_CONN_RETRY_INTERVAL_TIME=5s
#NB_CONN_MAX_RETRY_INTERVAL_TIME=60s

# --- Module defaults (usually leave alone) ---
#NB_DISABLE_DNS=true
#NB_DISABLE_SSH_CONFIG=true
#NB_SKIP_NFTABLES_CHECK=true
#NB_SKIP_DNS_PROBE=true
#NB_NETWORK_MONITOR=true
#NB_STATE_DIR=/data/adb/netbird

# --- Status watcher / watchdog ---
# Seconds between status + route refresh cycles (watcher interval)
#NB_PROP_UPDATE_INTERVAL=60
# Watchdog: auto-restart the daemon when its status stops responding.
#   on  - probe once per cycle; restart after NB_WATCHDOG_FAILS consecutive
#         failures (budget: NB_WATCHDOG_MAX_RESTARTS, reset after 5 healthy
#         cycles)
#   off - never restart automatically
#NB_WATCHDOG=on
#NB_WATCHDOG_FAILS=3
#NB_WATCHDOG_MAX_RESTARTS=10
